{
  "name": "project-inspector",
  "version": "0.3.0",
  "description": "Offline-first deterministic project analysis CLI (AST, security, architecture)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BhaumikJoshi/project-inspector.git"
  },
  "homepage": "https://github.com/BhaumikJoshi/project-inspector#readme",
  "bugs": {
    "url": "https://github.com/BhaumikJoshi/project-inspector/issues"
  },
  "type": "module",
  "bin": {
    "project-inspector": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "plugins",
    "schemas"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import tsx src/cli.ts",
    "prepublishOnly": "npm run build",
    "lint": "eslint src --max-warnings 0",
    "test": "node --import tsx --test src/engines/api-engine.command.test.ts src/reports/writers.exports.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "refresh-majors": "npx tsx scripts/refresh-known-majors.ts"
  },
  "keywords": [
    "cli",
    "security",
    "ast",
    "static-analysis",
    "nextjs",
    "react"
  ],
  "author": "project-inspector contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3",
    "pino": "^10.3.1",
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  }
}
