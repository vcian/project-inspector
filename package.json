{
  "name": "@vcian/project-inspector",
  "version": "0.3.3",
  "description": "Offline, fully static code-analysis CLI for Node.js, JavaScript & TypeScript projects (Express, NestJS, Next.js, React) — runs deterministic AST-based security, dependency, and architecture audits with zero network calls, and generates HTML reports, ER diagrams, and OpenAPI specs for code review, DevSecOps, and CI/CD.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcian/project-inspector.git"
  },
  "homepage": "https://github.com/vcian/project-inspector#readme",
  "bugs": {
    "url": "https://github.com/vcian/project-inspector/issues"
  },
  "type": "module",
  "bin": {
    "project-inspector": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schemas",
    "packs"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node --eval \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true,force:true});\"",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/verify-build.mjs",
    "dev": "node --import tsx src/cli.ts",
    "prepublishOnly": "npm run clean && npm run build && npm run ci",
    "lint": "eslint src --max-warnings 0",
    "test": "node --import tsx --test src/engines/api-engine.command.test.ts src/reports/writers.exports.test.ts src/engines/security-engine.test.ts src/engines/performance-engine.test.ts src/core/scoring-engine.test.ts src/utils/type-guards.test.ts src/utils/path-safety.test.ts src/core/scan-runner.stage.test.ts",
    "test:coverage": "c8 --reporter=lcov --reporter=text npm test",
    "ci": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "refresh-majors": "npx tsx scripts/refresh-known-majors.ts",
    "docs:catalog": "node scripts/gen-rules-catalog.mjs"
  },
  "keywords": [
    "cli",
    "security",
    "ast",
    "static-analysis",
    "nextjs",
    "react",
    "typescript",
    "code-analysis",
    "sarif",
    "sbom",
    "owasp",
    "dependency-audit",
    "linting",
    "project-analysis",
    "inspector",
    "code-quality",
    "security-scanner",
    "devsecops",
    "code-review",
    "audit",
    "nodejs",
    "javascript",
    "express",
    "nestjs",
    "ci-cd",
    "html-report",
    "er-diagram",
    "openapi",
    "dependency-analysis",
    "tech-debt",
    "monorepo"
  ],
  "author": {
    "name": "Viitorcloud Technologies Pvt. Ltd.",
    "email": "support@viitorcloud.com",
    "url": "https://viitorcloud.com"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ts-morph": "^25.0.1",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^26.1.1",
    "c8": "^10.1.3",
    "eslint": "^9.24.0",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.30.1"
  }
}
